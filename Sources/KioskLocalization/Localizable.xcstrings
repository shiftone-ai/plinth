  "strings": {
    "30秒後にもう一度入力してください": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30秒後にもう一度入力してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in 30 seconds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30초 후 다시 입력하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 30 秒后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 30 秒後重試"
          }
        }
      }
    },
