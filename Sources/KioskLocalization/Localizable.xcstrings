    "Plinthを全画面表示にしてください。": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinthを全画面表示にしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Plinth to full screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinth를 전체 화면으로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 Plinth 切换为全屏显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將 Plinth 切換為全螢幕顯示。"
          }
        }
      }
    },
    "Plinthを終了": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinthを終了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Plinth"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinth 종료"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Plinth"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 Plinth"
          }
        }
      }
    },
    "「設定」の「マルチタスクとジェスチャ」で「フルスクリーンアプリ」を選び、Plinthに戻ってください。": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」の「マルチタスクとジェスチャ」で「フルスクリーンアプリ」を選び、Plinthに戻ってください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, choose Full Screen Apps under Multitasking & Gestures, then return to Plinth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 멀티태스킹 및 제스처에서 전체 화면 앱을 선택한 다음 Plinth로 돌아오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”的“多任务处理与手势”中选择“全屏 App”，然后返回 Plinth。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」的「多工處理與手勢」中選擇「全螢幕 App」，然後返回 Plinth。"
          }
        }
      }
    },
