    "The damaged file stays on this device. You can import an encrypted backup into the new collection.": {
      "comment": "Settings collection recovery text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The damaged file stays on this device. You can import an encrypted backup into the new collection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壊れたファイルはこの端末に残します。新しい設定集には、暗号化したバックアップを読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 파일은 이 기기에 보관됩니다. 암호화된 백업을 새 설정 모음으로 가져올 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "损坏的文件会保留在此设备上。你可以将加密备份导入新的设置集合。"
          }
