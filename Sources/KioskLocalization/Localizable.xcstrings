          "stringUnit": {
            "state": "translated",
            "value": "Plinth 종료"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Plinth"
          }
        }
      }
    },
    "In Settings, choose Full Screen Apps under Multitasking & Gestures, then return to Plinth.": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」の「マルチタスクとジェスチャ」で「フルスクリーンアプリ」を選び、Plinthに戻ってください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, choose Full Screen Apps under Multitasking & Gestures, then return to Plinth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 멀티태스킹 및 제스처에서 전체 화면 앱을 선택한 다음 Plinth로 돌아오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”的“多任务处理与手势”中选择“全屏 App”，然后返回 Plinth。"
          }
        }
      }
    },
