    "Switch Plinth to full screen.": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinthを全画面表示にしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Plinth to full screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinth를 전체 화면으로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 Plinth 切换为全屏显示。"
          }
        }
      }
    },
    "Quit Plinth": {
      "comment": "Interface text for the kiosk administration and exhibition controls.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plinthを終了"
